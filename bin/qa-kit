#!/usr/bin/env node
// qa-kit parts [--all]  → prints the parts the change touches, as JSON
// qa-kit fast  [--all]  → runs those parts' fast commands; exits 1 if any fails
// qa-kit report         → CI: posts the /kontrol report to the PR
// qa-kit comment        → CI: posts one finding to the PR right away (JSON on stdin)
import { execSync, spawnSync } from "node:child_process";
import { appendFileSync, existsSync, readFileSync } from "node:fs";
import { join, matchesGlob } from "node:path";

const [command, ...flags] = process.argv.slice(2);
const all = flags.includes("--all");
const git = (args) => execSync(`git ${args}`, { encoding: "utf8" }).trim();
const root = git("rev-parse --show-toplevel");
process.chdir(root);
const config = JSON.parse(readFileSync(join(root, "qa-kit.json"), "utf8"));
const parts = Object.entries(config.parts);

function changedFiles() {
	const base = git(`merge-base origin/${config.base} HEAD`);
	const lists = [`diff --name-only ${base}`, "diff --name-only HEAD", "ls-files --others --exclude-standard"];
	const files = new Set(lists.flatMap((args) => git(args).split("\n")).filter(Boolean));
	const globs = [...(config.ignore ?? []), `${config.specs}/**`, `${config.findings}/**`];
	const ignored = (file) => {
		return file === "qa-kit.json" || globs.some((glob) => matchesGlob(file, glob));
	};
	return [...files].filter((file) => !ignored(file));
}

const inPart = (file, path) => path === "." || file.startsWith(`${path}/`);

// Folders with their own tests that no part covers would go unchecked without anyone noticing.
function uncoveredTestFolders() {
	const tracked = git("ls-files").split("\n");
	const hasTests = (file) => {
		const dir = file.slice(0, file.lastIndexOf("/") + 1);
		if (file.endsWith("pubspec.yaml")) return tracked.some((f) => f.startsWith(`${dir}test/`));
		return file.endsWith("package.json") && Boolean(JSON.parse(readFileSync(file, "utf8")).scripts?.test);
	};
	const dirs = tracked.filter((f) => /(^|\/)(package\.json|pubspec\.yaml)$/.test(f) && hasTests(f)).map((f) => f.slice(0, f.lastIndexOf("/") + 1));
	// The root of a multi-package repo only runs the others' tests.
	const own = dirs.length > 1 ? dirs.filter((dir) => dir !== "") : dirs;
	return own.filter((dir) => !parts.some(([, part]) => inPart(dir || "./", part.path)));
}

function affectedParts() {
	if (all) return parts;
	const touched = new Set();
	for (const file of changedFiles()) {
		const owners = parts.filter(([, part]) => inPart(file, part.path));
		// A file outside every part is shared code, so every part may depend on it.
		for (const [name] of owners.length ? owners : parts) touched.add(name);
	}
	return parts.filter(([name]) => touched.has(name));
}

const pr = () => process.env.GITHUB_EVENT_PATH && JSON.parse(readFileSync(process.env.GITHUB_EVENT_PATH, "utf8")).pull_request;
const gh = (args, input) => spawnSync("gh", args, { input, stdio: ["pipe", "inherit", "inherit"] }).status;

// CI only: posts .qa/report.md as the PR comment, then fails unless .qa/verdict says pass.
function report() {
	const read = (file, fallback) => {
		return existsSync(file) ? readFileSync(file, "utf8") : fallback;
	};
	const body = read(".qa/report.md", "qa-kit wrote no report.");
	if (process.env.GITHUB_STEP_SUMMARY) appendFileSync(process.env.GITHUB_STEP_SUMMARY, body);
	const { number } = pr() ?? {};
	if (number) {
		// Replace the old report rather than edit it, so the newest one is always the last comment.
		const marker = "<!-- qa-kit report -->";
		const issue = `repos/${process.env.GITHUB_REPOSITORY}/issues/${number}/comments`;
		const old = execSync(`gh api --paginate ${issue} --jq '.[] | select(.body | startswith("${marker}")) | .id'`, { encoding: "utf8" });
		for (const id of old.split("\n").filter(Boolean)) gh(["api", "-X", "DELETE", `repos/${process.env.GITHUB_REPOSITORY}/issues/comments/${id}`]);
		const help = "\n\n<sub>[qa-kit nedir, rapor nasıl okunur?](https://github.com/Boby-AI/qa-kit/blob/main/KILAVUZ.md)</sub>";
		gh(["pr", "comment", String(number), "--body-file", "-"], `${marker}\n${body}${help}`);
	}
	process.exit(read(".qa/verdict", "").trim() === "pass" ? 0 : 1);
}

// CI only: posts one finding the moment it is found, so the author can start fixing before the run ends.
// stdin: {"path", "line", "body"}; without a path, or on a line outside the diff, it becomes a plain PR comment.
function comment() {
	const { path, line, body } = JSON.parse(readFileSync(0, "utf8"));
	const { number, head } = pr() ?? {};
	if (!number) {
		console.log(body);
		return;
	}
	const inline = { commit_id: head.sha, path, line, side: "RIGHT", body };
	const url = `repos/${process.env.GITHUB_REPOSITORY}/pulls/${number}/comments`;
	if (path && line && gh(["api", url, "--input", "-"], JSON.stringify(inline)) === 0) return;
	gh(["pr", "comment", String(number), "--body-file", "-"], path ? `\`${path}:${line}\`\n\n${body}` : body);
}

if (command === "report") report();
if (command === "comment") {
	comment();
	process.exit(0);
}

const affected = affectedParts();
for (const dir of uncoveredTestFolders()) console.error(`⚠ qa-kit.json: ${dir || "./"} has tests but no part covers it`);

if (command === "parts") {
	console.log(JSON.stringify(Object.fromEntries(affected), null, 2));
} else if (command === "fast") {
	const failed = [];
	for (const [name, part] of affected) {
		for (const cmd of part.fast ?? []) {
			console.log(`\n▶ ${name}: ${cmd}`);
			if (spawnSync(cmd, { shell: true, stdio: "inherit" }).status !== 0) failed.push(`${name}: ${cmd}`);
		}
	}
	console.log(affected.length ? `\n${failed.length ? "FAIL" : "PASS"} (${affected.map(([n]) => n).join(", ")})` : "Nothing changed.");
	for (const f of failed) console.log(`  ✗ ${f}`);
	process.exit(failed.length ? 1 : 0);
} else {
	console.log("usage: qa-kit parts|fast [--all] | report | comment");
	process.exit(2);
}
